<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💸 REMAIN POOR 💸"
                    android:textSize="30sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The reverse millionaire experience"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

        <!-- PLAYER STATS -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 PLAYER STATS"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTotalCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Coins: 0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"/>

                <TextView
                    android:id="@+id/tvTotalPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Points: 0"
                    android:textSize="20sp"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/tvInventory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inventory"
                    android:textSize="18sp"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MAIN ACTIONS -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 GAME MODES"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnStartGame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎮 START GAME (GENERAL)"
                    android:textSize="18sp"
                    android:minHeight="64dp"
                    android:layout_marginTop="20dp"/>

                <Button
                    android:id="@+id/btnSlotMachine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎰 SLOT MACHINE"
                    android:textSize="18sp"
                    android:minHeight="64dp"
                    android:layout_marginTop="16dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CATEGORY SECTION -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvCategoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔓 UNLOCKABLE CATEGORIES"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spend points to unlock more question pools"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

                <Button
                    android:id="@+id/btnGaming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎮 Gaming (50 Points)"
                    android:textSize="17sp"
                    android:minHeight="60dp"
                    android:layout_marginTop="24dp"/>

                <Button
                    android:id="@+id/btnMovies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎬 Movies (75 Points)"
                    android:textSize="17sp"
                    android:minHeight="60dp"
                    android:layout_marginTop="14dp"/>

                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏛 History (100 Points)"
                    android:textSize="17sp"
                    android:minHeight="60dp"
                    android:layout_marginTop="14dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ADMIN PANEL -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙ ADMIN TOOLS"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage quiz questions and database content"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

                <Button
                    android:id="@+id/btnAdminPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OPEN ADMIN PANEL"
                    android:textSize="18sp"
                    android:minHeight="60dp"
                    android:layout_marginTop="20dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>