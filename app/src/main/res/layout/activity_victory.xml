<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvVictoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆 YOU WON!"
        android:textSize="40sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvVictorySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You survived capitalism"
        android:textSize="18sp"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tvVictoryCoins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Final Coins: 0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"/>

    <Button
        android:id="@+id/btnVictoryMenu"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:text="🏠 BACK TO MENU"
        android:textSize="18sp"
        android:layout_marginTop="40dp"/>

    <Button
        android:id="@+id/btnShare"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:text="📤 SHARE RESULTS"
        android:textSize="18sp"
        android:layout_marginTop="16dp"/>

</LinearLayout>