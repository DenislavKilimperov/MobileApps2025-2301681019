<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etEditQuestion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Question" />

        <EditText
            android:id="@+id/etEditOptionA"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Option A" />

        <EditText
            android:id="@+id/etEditOptionB"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Option B" />

        <EditText
            android:id="@+id/etEditOptionC"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Option C" />

        <EditText
            android:id="@+id/etEditOptionD"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Option D" />

        <EditText
            android:id="@+id/etEditCorrectAnswer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Correct Answer" />

        <EditText
            android:id="@+id/etEditCategory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Category" />

        <EditText
            android:id="@+id/etEditDifficulty"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Difficulty" />

        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="SAVE CHANGES" />

    </LinearLayout>

</ScrollView>